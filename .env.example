# paper_rag 环境变量样例。复制为 .env 并填入真实值; .env 已被 .gitignore 忽略, 永不提交。

# ── LLM(OpenAI 兼容端点)──
# 通义千问 / DashScope 兼容模式:
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-your-dashscope-key
# 商业稳定版非流式默认关思考, 是非流式 chat() 的稳妥选择;
# 若换 qwen3 开源版/思考型模型, 需在配置 llm.extra_body 加 {enable_thinking: false}
CHAT_MODEL=qwen-plus
SMALL_MODEL=qwen-turbo

# ── 可选: 指定配置文件(缺省 config/default.yaml)──
# PAPER_RAG_CONFIG=config/local.yaml
