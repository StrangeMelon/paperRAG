# paper_rag 环境变量样例。复制为 .env 并填入真实值; .env 已被 .gitignore 忽略, 永不提交。

# ── LLM(OpenAI 兼容端点)──
# 通义千问 / DashScope 兼容模式:
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-your-dashscope-key
# 商业稳定版非流式默认关思考, 是非流式 chat() 的稳妥选择;
# 若换 qwen3 开源版/思考型模型, 需在配置 llm.extra_body 加 {enable_thinking: false}
CHAT_MODEL=qwen-plus
SMALL_MODEL=qwen-turbo

# ── Wiki 专用 LLM(可选; 未设置时沿用上面的全局 LLM)──
# DeepSeek 官方 OpenAI 兼容端点。批量抽取建议显式关闭 thinking 以降低费用和延迟。
WIKI_LLM_BASE_URL=https://api.deepseek.com
WIKI_LLM_API_KEY=sk-your-deepseek-key
WIKI_LLM_MODEL=deepseek-v4-flash
WIKI_LLM_THINKING=disabled
# 仅 thinking=enabled 时设置；原生 low/high/max，兼容 medium/xhigh 映射。
# WIKI_LLM_REASONING_EFFORT=low
# 阿里云托管的 DeepSeek 参数不同：在本地 YAML 将 wiki.llm.thinking 设为 null，
# 并将 wiki.llm.extra_body 设为 {enable_thinking: false}。

# ── 视觉摘要(figure/table 图片转文字, OpenAI 兼容端点)──
# 智谱 GLM-4.6V(注意: 智谱 temperature 为 (0,1) 开区间, 故 vision.temperature 默认 0.01):
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
VISION_API_KEY=your-zhipu-key
VISION_MODEL=glm-4.6v
# 若该模型默认开思考并吐 reasoning_content, 在配置 vision.extra_body 加
# {thinking: {type: disabled}}; 默认空表时请求形参与不带该键完全一致。

# ── 可选: 指定配置文件(缺省 config/default.yaml)──
# PAPER_RAG_CONFIG=config/local.yaml
